statement ok
CREATE SECRET auth_bad (TYPE rabbitmq, MANAGEMENT_URL '{RABBITMQ_FIXTURE_AUTH_URL}', USERNAME 'monitor', PASSWORD 'wrong', SCOPE 'rabbitmq://auth_bad');

statement error
SELECT * FROM rabbitmq.main.vhosts(secret_name := 'auth_bad');
----
HTTP 401

statement ok
CREATE SECRET auth_basic (TYPE rabbitmq, MANAGEMENT_URL '{RABBITMQ_FIXTURE_AUTH_URL}', USERNAME 'monitor', PASSWORD 'monitor-pass', SCOPE 'rabbitmq://auth_basic');

query I
SELECT count(*) FROM rabbitmq.main.vhosts(secret_name := 'auth_basic');
----
2

statement ok
CREATE SECRET auth_oauth (TYPE rabbitmq, MANAGEMENT_URL '{RABBITMQ_FIXTURE_AUTH_URL}/', BEARER_TOKEN 'test-token', SCOPE 'rabbitmq://auth_oauth');

query I
SELECT count(*) FROM rabbitmq.main.vhosts(secret_name := 'auth_oauth');
----
2

# stream_messages needs AMQP_URL.
statement error
SELECT * FROM rabbitmq.main.stream_messages('shop', 'events');
----
AMQP_URL

# ------------------------------------------------------------------ offline tools

query TT
SELECT p, rabbitmq.main.topic_matches(p, 'orders.created.eu') FROM (VALUES ('orders.*'), ('orders.*.eu'), ('orders.#'), ('#'), ('*.paid'), ('orders.created.eu.#'), (NULL)) t(p) ORDER BY p NULLS LAST;
----
#	true
*.paid	false
orders.#	true
orders.*	false
orders.*.eu	true
orders.created.eu.#	true
NULL	NULL

# Routing simulation: where would orders.created.eu go?
query T
SELECT destination FROM rabbitmq.main.bindings(vhost := 'shop') WHERE source = 'orders' AND rabbitmq.main.topic_matches(routing_key, 'orders.created.eu') ORDER BY destination;
----
events
orders.archive
orders.created

query T
SELECT rabbitmq.main.mask_uri(u) FROM (VALUES ('amqp://app:s3cret@mq:5672/shop'), ('amqps://mq/?password=x&heartbeat=5'), (NULL)) t(u) ORDER BY 1 NULLS LAST;
----
amqp://app:****@mq:5672/shop
amqps://mq/?password=****&heartbeat=5
NULL

# Many rows across batches.
query II
SELECT count(*), count(*) FILTER (WHERE rabbitmq.main.topic_matches('a.#', 'a.' || i::VARCHAR)) FROM range(5000) t(i);
----
5000	5000
