      "write": ".*",
      "read": ".*"
    },
    {
      "user": "admin",
      "vhost": "shop",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "monitor",
      "vhost": "shop",
      "configure": "^$",
      "write": "^$",
      "read": ".*"
    },
    {
      "user": "orders-app",
      "vhost": "shop",
      "configure": "^orders\\..*",
      "write": "^orders.*",
      "read": "^orders\\..*"
    }
  ],
  "topic_permissions": [
    {
      "user": "orders-app",
      "vhost": "shop",
      "exchange": "orders",
      "write": "^orders\\.",
      "read": ".*"
    }
  ],
  "parameters": [
    {
      "vhost": "shop",
      "component": "shovel",
      "name": "orders-to-archive",
      "value": {
        "src-protocol": "amqp091",
        "src-uri": "amqp://",
        "src-queue": "legacy.outbox",
        "dest-protocol": "amqp091",
        "dest-uri": "amqp://shovel_user:S3cr3tShovelPass@archive.invalid:5672/archive",
        "dest-queue": "orders.archived",
        "ack-mode": "on-confirm",
        "src-delete-after": "never",
        "reconnect-delay": 3600
      }
    },
    {
      "vhost": "shop",
      "component": "federation-upstream",
      "name": "dc2",
      "value": {
        "uri": "amqps://fed_user:FedS3cret@dc2.invalid:5671/shop?cacertfile=/etc/ca.pem",
        "expires": 3600000,
        "ack-mode": "on-confirm",
        "trust-user-id": false
      }
    }
  ],
  "global_parameters": [
    {
      "name": "cluster_name",
      "value": "vgi-fixture"
    }
  ],
  "policies": [
    {
      "vhost": "shop",
      "name": "orders-ttl",
      "pattern": "^orders\\.",
      "apply-to": "queues",
      "priority": 1,
      "definition": {
        "message-ttl": 86400000,
        "max-length": 100000
      }
    }
  ],
  "queues": [
    {
      "name": "orders.created",
      "vhost": "shop",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "classic"
